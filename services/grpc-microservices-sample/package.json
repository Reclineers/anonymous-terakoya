{
  "name": "grpc-microservices-sample",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm -r --parallel --filter='./apps/backend/*' dev",
    "dev:frontend": "pnpm -r --parallel --filter='./apps/frontend/*' dev",
    "build": "pnpm -r build",
    "proto:generate": "pnpm --filter @packages/proto generate"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
